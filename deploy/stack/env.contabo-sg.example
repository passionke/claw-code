# contabo-sg external release. Copy to repo root .env on that host only. Author: kejiqing
# Do not copy the home neurogate .env. Do not build on this machine.
#
#   ./deploy/stack/gateway.sh install-docker
#   cp deploy/stack/env.contabo-sg.example .env
#   # set CLAW_E2B_API_KEY and replace the postgres password
#   CLAW_E2B_WORKER_BASE_TAG=release-vX.Y.Z
#   ./deploy/stack/gateway.sh up --release release-vX.Y.Z
#   bash deploy/e2b/bootstrap-templates-from-ci-tag.sh release-vX.Y.Z
#   ./deploy/stack/gateway.sh verify
#
# Upgrade is the same up --release with the new tag. e2bserver is not started here.

CLAW_DEPLOY_PROFILE=production
CLAW_CONTAINER_RUNTIME=docker
CLAW_SOLVE_ISOLATION=e2b

CLAW_IMAGE_PREFIX=crpi-cf9vxpq3n8or17mw.cn-hangzhou.personal.cr.aliyuncs.com/passionke
CLAW_E2B_WORKER_BASE_TAG=release-vX.Y.Z

CLAW_CLUSTER_ID=contabo-sg-01
CLAW_POOL_ADVERTISE_HOST=62.72.45.75
GATEWAY_HOST_PORT=18088
GATEWAY_PLAYGROUND_HOST_PORT=18675
CLAW_TIMEOUT_SECONDS=1800

# Compose postgres. up --release starts it when the host is "postgres".
CLAW_GATEWAY_DATABASE_URL=postgres://claw_gateway:change-me@postgres:5432/claw_gateway
CLAW_GATEWAY_PG_HOST_PORT=5433

# e2bserver on this host. Its own release brings the process up; these are only the client URLs.
CLAW_E2B_API_URL=http://127.0.0.1:3000
CLAW_E2B_SANDBOX_URL=http://127.0.0.1:3002
CLAW_E2B_API_KEY=

# After bootstrap, Admin agentEngines.claw.ref is the public Release asset:
# https://github.com/passionke/claw-code/releases/download/release-vX.Y.Z/neuro-harness-acp-X.Y.Z-amd64.tar.gz
