# Local router/delegate acceptance — Mac gateway + shared e2b (94/10.8.0.x fleet)
# Author: kejiqing
#
# ⚠️ 勿改预发 252 / prod-claw-252 配置。本 profile 用独立 CLAW_CLUSTER_ID 隔离数据。
#
#   cp deploy/stack/env.local-router-test.example .env
#   # 合并 deploy/stack/env.selfhosted-e2b.example 中的 CLAW_E2B_* / NAS / PG 段落并填 key
#   ./deploy/stack/gateway.sh pack-deploy local
#   ./deploy/stack/gateway.sh up
#
# 验收脚本见 scripts/gpos-router-split/README-local-test.md

CLAW_DEPLOY_PROFILE=local
# 与 prod-claw-252 / 预发 cluster 隔离
CLAW_CLUSTER_ID=router-test-local

GATEWAY_PLAYGROUND_HOST_PORT=18765
PLAYGROUND_PUBLIC_GATEWAY_BASE=http://127.0.0.1:18088
CLAW_GATEWAY_BASE=http://127.0.0.1:18088

# 共用 PG（10.8.0.1:5433）；行级隔离靠 CLAW_CLUSTER_ID
# CLAW_GATEWAY_DATABASE_URL=postgres://claw_gateway:<password>@10.8.0.1:5433/claw_gateway
# CLAW_E2B_WORKER_DATABASE_URL=postgres://claw_gateway:<password>@10.8.0.1:5433/claw_gateway

# e2b：借用 94 所在 fleet（traffic 经 10.22.28.94；API 通常 10.8.0.1:3000）
# 完整段落见 env.selfhosted-e2b.example
# CLAW_E2B_API_URL=http://10.8.0.1:3000
# CLAW_E2B_SANDBOX_URL=http://10.8.0.1:3002
# CLAW_E2B_DOMAIN=supone.top
# CLAW_E2B_TEMPLATE=claw-worker
# CLAW_E2B_DEV_WORKER_HOST=10.8.0.2

CLAW_SOLVE_ISOLATION=e2b
CLAW_INTERACTIVE_BACKEND=e2b
CLAW_TIMEOUT_SECONDS=900
