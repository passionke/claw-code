# Rust compile toolchain image: mold linker + sccache (linux-compile only). Author: kejiqing
ARG RUST_BASE_IMAGE=docker.1ms.run/library/rust:1.88-bookworm
FROM ${RUST_BASE_IMAGE}

COPY deploy/stack/debian-bookworm-ustc.sources /tmp/debian-cn.sources
# Default USTC apt (94 / 国内). GitHub Actions passes CLAW_USE_CN_APT_MIRROR=0.
ARG CLAW_USE_CN_APT_MIRROR=1
ARG SCCACHE_VERSION=v0.10.0
# Override in CN (e.g. https://ghfast.top/https://github.com/mozilla/sccache/releases/download). Author: kejiqing
ARG SCCACHE_BASE_URL=https://github.com/mozilla/sccache/releases/download

RUN if [ "${CLAW_USE_CN_APT_MIRROR}" = "1" ]; then \
      cp /tmp/debian-cn.sources /etc/apt/sources.list.d/debian.sources; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
    mold \
    clang \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ARCH="$(dpkg --print-architecture)" \
    && case "${ARCH}" in \
         amd64) SCCACHE_ARCH=x86_64-unknown-linux-musl ;; \
         arm64) SCCACHE_ARCH=aarch64-unknown-linux-musl ;; \
         *) echo "unsupported arch: ${ARCH}" >&2; exit 1 ;; \
       esac \
    && SCCACHE_URL="${SCCACHE_BASE_URL}/${SCCACHE_VERSION}/sccache-${SCCACHE_VERSION}-${SCCACHE_ARCH}.tar.gz" \
    && echo "==> fetch sccache ${SCCACHE_URL}" \
    && curl --http1.1 -fL --connect-timeout 20 --max-time 180 --retry 3 --retry-delay 2 \
         -o /tmp/sccache.tgz "${SCCACHE_URL}" \
    && tar xz -C /usr/local/bin --strip-components=1 \
         -f /tmp/sccache.tgz "sccache-${SCCACHE_VERSION}-${SCCACHE_ARCH}/sccache" \
    && rm -f /tmp/sccache.tgz \
    && chmod +x /usr/local/bin/sccache \
    && sccache --version \
    && mold --version

# Self-contained pinned toolchain: rust-toolchain.toml declares rustfmt+clippy.
# Pre-install so linux-compile never triggers an online `rustup` channel sync.
RUN rustup component add rustfmt clippy \
    && rustfmt --version \
    && cargo clippy --version
