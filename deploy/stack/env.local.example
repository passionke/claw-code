# macOS + Podman local dev — merge into repo root `.env`
#   cp deploy/stack/env.local.example .env
#   ./deploy/stack/gateway.sh quick
# Author: kejiqing
#
# tap / worker / gateway 网络默认值在 env-profile.sh（Darwin 自动 claw_default + docker tap）。
# macOS：env-profile 自动 CLAW_WORKER_UID/GID=宿主机 uid（bind mount + gateway compose）；勿在 .env 手写 1000。
# 推荐外连 e2b：deploy/stack/env.selfhosted-e2b.example + docs/architecture-governance.md

CLAW_DEPLOY_PROFILE=local
CLAW_CLUSTER_ID=local-dev

GATEWAY_PLAYGROUND_HOST_PORT=18765
PLAYGROUND_PUBLIC_GATEWAY_BASE=http://127.0.0.1:18088

# OVS Web IDE（passionke/openvscode-server:1.109.5-ovs-chat）；见 deploy/stack/ovs-image.env
# CLAW_OVS_HOST_PORT=13000

# solve / gateway-solve-once 超时（秒）；默认 15min
CLAW_TIMEOUT_SECONDS=900

# Session attachment OSS dual-write (NAS short-lived; OSS long TTL). Author: kejiqing
# CLAW_OSS_ENABLED=1
# CLAW_OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com
# CLAW_OSS_REGION=ap-southeast-1
# CLAW_OSS_BUCKET=clawcode-sessions
# CLAW_OSS_ACCESS_KEY_ID=
# CLAW_OSS_ACCESS_KEY_SECRET=
# CLAW_OSS_KEY_PREFIX=sessions
# CLAW_OSS_OBJECT_TTL_DAYS=730
# CLAW_OSS_SIGNED_URL_TTL_SECS=3600
