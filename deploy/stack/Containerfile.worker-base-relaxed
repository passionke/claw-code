# Relaxed thin shell: curl/git/python3/pip — still NO claw/neuro. Author: kejiqing
ARG WORKER_BASE_IMAGE=claw-worker-base:local

FROM ${WORKER_BASE_IMAGE}

USER root
COPY deploy/stack/debian-bookworm-ustc.sources /tmp/debian-cn.sources
ARG CLAW_USE_CN_APT_MIRROR=0
RUN if [ "${CLAW_USE_CN_APT_MIRROR}" = "1" ]; then \
      cp /tmp/debian-cn.sources /etc/apt/sources.list.d/debian.sources; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    python3 \
    python3-pip \
    && ln -sf /usr/bin/pip3 /usr/local/bin/pip \
    && rm -rf /var/lib/apt/lists/* \
    && test ! -e /usr/local/bin/claw

USER claw
