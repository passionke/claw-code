# neuro-opencode worker: strict worker + opencode binary from the npm platform tgz (version and
# sha512 integrity pinned). Built by deploy/neuro-harness/build-worker-images.sh. Author: kejiqing
ARG WORKER_BASE_IMAGE=claw-gateway-worker:local
ARG NODE_BASE_IMAGE=docker.1ms.run/library/node:22-bookworm-slim

FROM ${NODE_BASE_IMAGE} AS opencode-fetch
ARG NPM_REGISTRY=https://registry.npmjs.org
ARG TARGETARCH
ARG OPENCODE_VERSION=1.18.34
ARG OPENCODE_INTEGRITY_AMD64=sha512-RTAMjCve4euxP2QKLuvRmdoW5J5DQK1DiZqt+7slfixyjAEi79QC2Df2oYKogibaAI4IEU8uzenoJeEl3k+UEw==
ARG OPENCODE_INTEGRITY_ARM64=sha512-ZSjqcH0MEbAzLEmkRC9Aop1PbWZxe2NuKONAE/x8MRQdjKdOepX7M50UpjbsNoiLMkP584Z98Mg4a42fJhouvA==
WORKDIR /fetch
RUN set -eu; \
    case "${TARGETARCH:-}" in \
      amd64) pkg=opencode-linux-x64; want="${OPENCODE_INTEGRITY_AMD64}" ;; \
      arm64) pkg=opencode-linux-arm64; want="${OPENCODE_INTEGRITY_ARM64}" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH:-<unset>} (use BuildKit/podman)" >&2; exit 1 ;; \
    esac; \
    npm pack "${pkg}@${OPENCODE_VERSION}" --registry "${NPM_REGISTRY}" --pack-destination /fetch >/dev/null; \
    tgz="/fetch/${pkg}-${OPENCODE_VERSION}.tgz"; \
    node -e 'const c=require("crypto"),f=require("fs");const got="sha512-"+c.createHash("sha512").update(f.readFileSync(process.argv[1])).digest("base64");if(got!==process.argv[2]){console.error("integrity mismatch: "+got);process.exit(1)}' "${tgz}" "${want}"; \
    tar -xzf "${tgz}" -C /fetch; \
    test -x /fetch/package/bin/opencode; \
    rm -rf /root/.npm

FROM ${WORKER_BASE_IMAGE}
USER root
COPY --from=opencode-fetch /fetch/package/bin/opencode /usr/local/lib/neuro-engines/opencode/bin/opencode
COPY deploy/stack/.linux-artifacts/release/neuro-opencode /usr/local/bin/neuro-opencode
RUN chmod 0755 /usr/local/bin/neuro-opencode /usr/local/lib/neuro-engines/opencode/bin/opencode
USER claw
