# neuro-appserver worker: strict worker + Node + codex-acp (npm ci from the committed lockfile,
# integrity-checked; bundles the codex binary). Built by deploy/neuro-harness/build-worker-images.sh.
# Author: kejiqing
ARG WORKER_BASE_IMAGE=claw-gateway-worker:local
ARG NODE_BASE_IMAGE=docker.1ms.run/library/node:22-bookworm-slim

FROM ${NODE_BASE_IMAGE} AS codex-install
ARG NPM_REGISTRY=https://registry.npmjs.org
WORKDIR /usr/local/lib/neuro-engines/codex-acp
COPY deploy/neuro-harness/codex-acp/package.json deploy/neuro-harness/codex-acp/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund --registry "${NPM_REGISTRY}" \
    && test -x node_modules/.bin/codex-acp \
    && rm -rf /root/.npm

FROM ${WORKER_BASE_IMAGE}
USER root
COPY --from=codex-install /usr/local/bin/node /usr/local/bin/node
COPY --from=codex-install /usr/local/lib/neuro-engines/codex-acp /usr/local/lib/neuro-engines/codex-acp
COPY deploy/stack/.linux-artifacts/release/neuro-appserver /usr/local/bin/neuro-appserver
RUN chmod 0755 /usr/local/bin/neuro-appserver
USER claw
