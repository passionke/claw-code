# Relaxed e2b protocol runtime: same claw/neuro layer plus development tools. Author: kejiqing
ARG WORKER_BASE_IMAGE=debian-bookworm-claw-worker:local

FROM ${WORKER_BASE_IMAGE}

USER root
COPY deploy/stack/debian-bookworm-ustc.sources /tmp/debian-cn.sources
ARG CLAW_USE_CN_APT_MIRROR=0
RUN if [ "${CLAW_USE_CN_APT_MIRROR}" = "1" ]; then \
      cp /tmp/debian-cn.sources /etc/apt/sources.list.d/debian.sources; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    python3 \
    python3-pip \
    && ln -sf /usr/bin/pip3 /usr/local/bin/pip \
    && rm -rf /var/lib/apt/lists/* \
    && command -v claw \
    && command -v neuro-opencode \
    && command -v neuro-appserver \
    && test ! -e /usr/local/lib/neuro-engines \
    && printf '%s\n' '#!/bin/sh' 'set -eu' 'exec sleep infinity' > /usr/local/bin/claw-worker-relaxed-start \
    && printf '%s\n' '#!/bin/sh' \
      'command -v claw >/dev/null 2>&1 && command -v neuro-opencode >/dev/null 2>&1 && command -v neuro-appserver >/dev/null 2>&1' \
      > /usr/local/bin/claw-worker-relaxed-ready \
    && chmod 0755 /usr/local/bin/claw-worker-relaxed-start /usr/local/bin/claw-worker-relaxed-ready

USER claw
