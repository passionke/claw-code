# Thin claw-worker-base-relaxed + e2b runtime (no baked claw). Author: kejiqing
ARG WORKER_BASE_IMAGE=claw-worker-base-relaxed:local
ARG DEBIAN_APT_MIRROR=
FROM ${WORKER_BASE_IMAGE}
ARG DEBIAN_APT_MIRROR
USER root
RUN if [ -n "${DEBIAN_APT_MIRROR}" ]; then \
      sed -i "s|mirrors.tuna.tsinghua.edu.cn|${DEBIAN_APT_MIRROR}|g; s|deb.debian.org|${DEBIAN_APT_MIRROR}|g; s|security.debian.org|${DEBIAN_APT_MIRROR}|g" \
        /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
      sed -i "s|mirrors.tuna.tsinghua.edu.cn|${DEBIAN_APT_MIRROR}|g; s|deb.debian.org|${DEBIAN_APT_MIRROR}|g; s|security.debian.org|${DEBIAN_APT_MIRROR}|g" \
        /etc/apt/sources.list 2>/dev/null || true; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    nfs-common \
    ca-certificates \
    sudo \
    && echo 'user ALL=(ALL) NOPASSWD: /bin/mount, /bin/umount, /usr/bin/mountpoint, /bin/mkdir, /bin/chown' > /etc/sudoers.d/claw-nfs \
    && chmod 440 /etc/sudoers.d/claw-nfs \
    && rm -rf /var/lib/apt/lists/*
# Ready must not require claw — CLI arrives via platform worker.init. Author: kejiqing
RUN printf '%s\n' \
        '#!/bin/sh' \
        'set -eu' \
        'exec sleep infinity' \
        > /usr/local/bin/claw-worker-relaxed-start \
    && printf '%s\n' \
        '#!/bin/sh' \
        'test -x /bin/sh' \
        > /usr/local/bin/claw-worker-relaxed-ready \
    && chmod +x /usr/local/bin/claw-worker-relaxed-start /usr/local/bin/claw-worker-relaxed-ready
